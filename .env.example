# Copia este archivo a .env y ajusta los valores. Todos son opcionales en desarrollo.
DB_PASSWORD=brujula
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
# URL pública del front (por defecto http://localhost:WEB_PORT). Necesaria para el enlace del correo de recuperación.
FRONTEND_URL=http://localhost:3000
# Client ID de Google (Google Cloud Console → Credenciales → ID de cliente OAuth, tipo "Aplicación web").
# Vacío = "Continuar con Google" simulado, solo válido con MODO_DESARROLLO=true.
GOOGLE_CLIENT_ID=
MODO_DESARROLLO=true
DATOS_EJEMPLO=true
ADMIN_EMAIL=admin@brujula.local
ADMIN_PASSWORD=Admin.2026
